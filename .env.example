# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database Settings (SQLite default for zero-setup, PostgreSQL ready)
DATABASE_URL=sqlite:///./nammaflood.db
# DATABASE_URL=postgresql://nammaflood_user:nammaflood_pass@localhost:5432/nammaflood_db

# Security & Admin Secret
API_V1_STR=/api/v1
SECRET_KEY=nammaflood-sentinel-dev-secret-key-bengaluru-2026
ADMIN_API_KEY=bengaluru-civic-admin-secret-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Upload Limits
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# Computer Vision & Agent Config
VISION_MODEL_ID=
FALLBACK_VISION_CONFIDENCE=0.85

# External Weather APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=900

# Geographic Center (Bengaluru)
BENGALURU_LAT=12.971598
BENGALURU_LON=77.594566

